{
  "openapi": "3.1.0",
  "info": {
    "title": "Dream Forge Public API",
    "version": "0.1.0",
    "description": "Machine-readable description of Dream Forge public storage proxy endpoints. Authenticated app workflows use Firebase callable functions and require a Firebase Authentication ID token."
  },
  "servers": [
    {
      "url": "https://dream-forge-r2-proxy.jackg825.workers.dev",
      "description": "Dream Forge R2 storage proxy"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Return proxy health status",
        "security": [],
        "responses": {
          "200": {
            "description": "Proxy is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/upload/direct": {
      "put": {
        "operationId": "uploadObject",
        "summary": "Upload and validate an object directly",
        "security": [
          {
            "firebaseIdToken": []
          }
        ],
        "parameters": [
          {
            "name": "filename",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "An allowed path prefix owned by the authenticated user."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/webp": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/gif": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/heic": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/heif": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "model/gltf-binary": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated object and signed download URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectUploadResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/download/presign": {
      "post": {
        "operationId": "createDownloadUrls",
        "summary": "Create short-lived signed download URLs",
        "security": [
          {
            "firebaseIdToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DownloadPresignRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed download URLs for authorized objects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadPresignResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/public/showcase/{objectName}": {
      "get": {
        "operationId": "downloadPublicObject",
        "summary": "Download a public showcase object",
        "security": [],
        "parameters": [
          {
            "name": "objectName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[^/]+$"
            },
            "description": "A single object filename under the public/showcase R2 prefix."
          }
        ],
        "responses": {
          "200": {
            "description": "Object bytes"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/download/{collection}/{userId}/{objectName}": {
      "get": {
        "operationId": "downloadUserObject",
        "summary": "Download a user object stored under a two-level R2 key",
        "parameters": [
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["uploads", "optimized", "h2c"]
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "objectName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[^/]+$"
            },
            "description": "A single R2 object filename. Slashes are represented by path segments in this OpenAPI document."
          },
          {
            "name": "sig",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exp",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {},
          {
            "firebaseIdToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Object bytes"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/download/{collection}/{userId}/{recordId}/{objectName}": {
      "get": {
        "operationId": "downloadRecordObject",
        "summary": "Download a record-scoped object such as a pipeline model or session model",
        "parameters": [
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["pipelines", "sessions"]
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "objectName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[^/]+$"
            }
          },
          {
            "name": "sig",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exp",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {},
          {
            "firebaseIdToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Object bytes"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
