            }
          },
          {
            "name": "sig",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exp",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {},
          {
            "firebaseIdToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Object bytes"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/download/pipelines/{userId}/{pipelineId}/preview/{objectName}": {
      "get": {
        "operationId": "downloadPipelinePreviewObject",
        "summary": "Download an admin pipeline preview object",
        "parameters": [
          {
