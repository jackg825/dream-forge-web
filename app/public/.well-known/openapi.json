  "components": {
    "securitySchemes": {
      "firebaseIdToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Firebase Authentication ID token issued by https://securetoken.google.com/dreamforge-66998."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid Firebase Authentication token"
      },
      "NotFound": {
        "description": "Requested object was not found"
      },
      "RateLimited": {
        "description": "Rate limit exceeded"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "timestamp": {
            "type": "integer"
          }
        },
        "required": ["status", "timestamp"]
      },
      "DirectUploadResponse": {
        "type": "object",
        "properties": {
          "downloadUrl": {
            "type": "string",
            "format": "uri"
          },
          "contentType": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["downloadUrl", "key", "size", "contentType"]
      },
      "DownloadPresignRequest": {
        "type": "object",
        "description": "Provide exactly one of key or keys.",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "oneOf": [
          {
            "required": ["key"]
          },
          {
            "required": ["keys"]
          }
        ],
        "additionalProperties": false
      },
      "DownloadPresignResponse": {
        "type": "object",
        "properties": {
          "downloadUrl": {
            "type": "string",
            "format": "uri"
          },
          "downloadUrls": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "format": "uri"
            }
          },
          "expiresIn": {
            "type": "integer"
          }
        },
        "required": ["downloadUrls", "expiresIn"]
      }
    }
  }
}
