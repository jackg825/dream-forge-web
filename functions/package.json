{
  "name": "dream-forge-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Dream Forge Photo-to-3D",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "axios": "^1.20.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2",
    "form-data": "^4.0.6",
    "gltfpack": "^1.0.0",
    "sharp": "^0.35.4",
    "tencentcloud-sdk-nodejs": "^4.1.303"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/sharp": "^0.31.1",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@google-cloud/firestore": "8.7.1",
    "@google-cloud/storage": "8.0.1",
    "form-data": "$form-data",
    "retry-request": "9.0.1",
    "teeny-request": "11.0.1",
    "uuid": "11.1.1"
  },
  "private": true
}
